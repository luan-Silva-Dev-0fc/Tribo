{
  "name": "tribo",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "eas-build-pre-install": "chmod +x ./android/gradlew 2>/dev/null || true",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "release:prod": "expo export:embed --entry-file index.js --platform android --dev false --bundle-output dist_codepush/index.android.bundle --assets-dest dist_codepush && revopush release tribo ./dist_codepush \"*\" -d Production -m --noDuplicateReleaseError",
    "release:staging": "expo export:embed --entry-file index.js --platform android --dev false --bundle-output dist_codepush/index.android.bundle --assets-dest dist_codepush && revopush release tribo ./dist_codepush \"*\" -d Staging -m --noDuplicateReleaseError"
  },
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@supabase/functions-js": "^2.112.2",
    "@supabase/supabase-js": "^2.112.2",
    "axios": "^1.18.1",
    "expo": "~54.0.37",
    "expo-av": "~16.0.8",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-media-library": "~18.2.1",
    "expo-notifications": "~0.32.17",
    "expo-screen-capture": "~8.0.10",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-code-push": "^9.0.1",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-youtube-iframe": "^2.4.1",
    "socket.io-client": "^4.8.3"
  },
  "private": true
}
